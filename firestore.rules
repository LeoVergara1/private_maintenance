rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Simplified: Check if user has manually created payments (admin flag)
      // or if role is admin in user document
      return isAuthenticated() && 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isGateManager() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gate_manager';
    }

    // Check if creating an admin payment (manual, semestral, annual)
    function isAdminPayment() {
      return request.resource.data.manuallyCreated == true &&
             request.resource.data.createdBy != null;
    }

    // Get house number for current user
    function getUserHouseNumber() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.houseNumber;
    }

    // Check if user is restricted from common area (e.g., due to unpaid fees or damage)
    function isUserRestricted() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.get('restrictedFromCommonArea', false) == true;
    }
    
    // Users collection rules
    match /users/{userId} {
      // Anyone authenticated can read any user document (needed for house number validation)
      allow read: if isAuthenticated();
      
      // Anyone authenticated can list users (needed for queries)
      allow list: if isAuthenticated();
      
      // Only the owner can create their own user document (onboarding)
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      
      // Admins can update user documents (for role changes, restrictions, etc)
      allow update: if isAdmin();
      
      // No one can delete users
      allow delete: if false;
    }
    
    // Payments collection rules
    match /payments/{paymentId} {
      // All authenticated users can read all payments (needed for financial reports)
      allow read: if isAuthenticated();
      
      // Users can create payments for themselves
      // Admins can create admin payments (manual, semestral, annual with manuallyCreated flag)
      allow create: if isAuthenticated() && 
                       (request.resource.data.userId == request.auth.uid || 
                        (isAdminPayment() && isAdmin()));
      
      // Only admins can update payments
      allow update: if isAdmin();
      
      // Only admins can delete payments
      allow delete: if isAdmin();
    }
    
    // Expenses collection rules
    match /expenses/{expenseId} {
      // All authenticated users can read expenses (needed for admin dashboard)
      allow read: if isAuthenticated();
      
      // All authenticated users can create expenses
      // (Access control via frontend - ExpensesPanel is admin-only)
      allow create: if isAuthenticated();
      
      // All authenticated users can update expenses
      allow update: if isAuthenticated();
      
      // All authenticated users can delete expenses
      allow delete: if isAuthenticated();
    }

    // Gate Controls collection rules
    match /gateControls/{controlId} {
      // Only admins and gate managers can read gate controls
      allow read: if isAdmin() || isGateManager();

      // Only admins and gate managers can create gate controls
      allow create: if isAdmin() || isGateManager();

      // Only admins and gate managers can update gate controls
      allow update: if isAdmin() || isGateManager();

      // Only admins and gate managers can delete gate controls
      allow delete: if isAdmin() || isGateManager();
    }

    // Initial Deposits collection rules
    match /initialDeposits/{depositId} {
      // All authenticated users can read initial deposits (needed for financial reports)
      allow read: if isAuthenticated();
      
      // Only admins can create initial deposits
      allow create: if isAdmin() && request.resource.data.amount > 0;
      
      // Only admins can update initial deposits
      allow update: if isAdmin();
      
      // Only admins can delete initial deposits
      allow delete: if isAdmin();
    }

    // Utilities collection rules
    match /utilities/{utilityId} {
      // Admins and gate managers can read utilities
      allow read: if isAdmin() || isGateManager();

      // Only admins can create utilities
      allow create: if isAdmin() && 
                       request.resource.data.category in ['Seguridad', 'Mantenimiento', 'Contactos', 'Notas Generales'] &&
                       request.resource.data.title != null &&
                       request.resource.data.content != null;

      // Only admins can update utilities
      allow update: if isAdmin() && 
                       request.resource.data.category in ['Seguridad', 'Mantenimiento', 'Contactos', 'Notas Generales'] &&
                       request.resource.data.title != null &&
                       request.resource.data.content != null;

      // Only admins can delete utilities
      allow delete: if isAdmin();
    }

    // Common Area Reservations collection rules
    match /commonAreaReservations/{reservationId} {
      // All authenticated users can read all reservations (needed for calendar view)
      allow read: if isAuthenticated();
      
      // Residents can create reservations for their own house
      // Admins can create for any house
      // Cannot create if user is restricted
      allow create: if isAuthenticated() && !isUserRestricted() && 
                       ((request.resource.data.houseNumber == getUserHouseNumber()) || isAdmin());
      
      // Update only by creator or admin (mainly for status/cancellation)
      allow update: if isAuthenticated() && 
                       (request.resource.data.createdBy == request.auth.uid || isAdmin());
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
  }
}
